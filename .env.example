# Root env example. The driver app reads apps/driver/.env (see apps/driver/.env.example).

# apps/driver
EXPO_PUBLIC_API_BASE=http://localhost:4000/api
APP_VARIANT=development
EXPO_PUBLIC_PUSH_TOKEN_KIND=device
# Secrets: EAS environment variables only.
EAS_PROJECT_ID=
GOOGLE_MAPS_ANDROID_API_KEY=

# apps/mock-api
PORT=4000
EXPORTS_DIR=./apps/mock-api/.data/evidence

# smoke suite: point at a running API instead of the in-process mock
# SMOKE_BASE=http://localhost:4000/api
