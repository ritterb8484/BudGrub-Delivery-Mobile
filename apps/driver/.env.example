# Driver app (apps/driver). Copy to apps/driver/.env for local runs. EAS profiles set these in eas.json / EAS environment variables.

# API base including the /api prefix. Android emulator reaches the host at 10.0.2.2.
EXPO_PUBLIC_API_BASE=http://localhost:4000/api

# development | staging | production (bundle id suffix, app name)
APP_VARIANT=development

# Which push token to register with POST /admin/driver/devices:
#   device = native FCM (Android) / APNs (iOS) token, matches the API's FCM sender (services/notifications.ts)
#   expo   = Expo push token (needs the API to send through Expo's push service)
EXPO_PUBLIC_PUSH_TOKEN_KIND=device

# Secrets: set as EAS environment variables (eas env:create), never commit real values.
EAS_PROJECT_ID=
GOOGLE_MAPS_ANDROID_API_KEY=
